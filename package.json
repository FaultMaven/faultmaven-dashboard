{
  "name": "faultmaven-dashboard",
  "version": "1.0.0",
  "description": "FaultMaven Dashboard — web app for case investigation review, knowledge base management, LLM configuration, and user administration",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "generate:api-types": "node scripts/generate-api-types.mjs",
    "check:sso-slugs": "node scripts/check-sso-error-slugs.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "check:copilot-pin": "node scripts/check-copilot-ui-pin.mjs",
    "check:web-boundary": "node scripts/check-web-bundle-boundary.mjs",
    "lint:tests": "eslint --no-ignore 'src/test/**/*.{ts,tsx}' 'src/**/*.test.{ts,tsx}'",
    "check:shared-ui-styles": "node scripts/check-shared-ui-styles.mjs"
  },
  "dependencies": {
    "@faultmaven/copilot-ui": "github:FaultMaven/faultmaven-copilot#707bebcd9c3cd33f1a4e55aa17c2f0a7f2b39204&path:packages/copilot-ui",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@tanstack/react-query": "^5.90.17",
    "highlight.js": "^11.11.1",
    "mermaid": "^11.16.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^20.8.9",
    "jsdom": "^27.3.0",
    "openapi-typescript": "^7.10.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "overrides": {
      "browserslist": "^4.28.7"
    }
  }
}
